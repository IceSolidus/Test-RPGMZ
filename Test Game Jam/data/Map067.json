":["",0,1,2,""]},{"code":401,"indent":0,"parameters":["Quelqu'un qui sait apprécier tes bébés et t'aidera à t'en"]},{"code":401,"indent":0,"parameters":["occuper."]},{"code":101,"indent":0,"parameters":["",0,1,2,""]},{"code":401,"indent":0,"parameters":["J'ai trouvé une personne idéale."]},{"code":401,"indent":0,"parameters":["Elle me dicte ce que je dois faire et sait ce qui me rend"]},{"code":401,"indent":0,"parameters":["heureux."]},{"code":101,"indent":0,"parameters":["",0,1,2,""]},{"code":401,"indent":0,"parameters":["Je vis maintenant loin de la ville comme ça tu ne risque"]},{"code":401,"indent":0,"parameters":["pas d'être malheureuse en me voyant."]},{"code":101,"indent":0,"parameters":["",0,1,2,""]},{"code":401,"indent":0,"parameters":["Ne t'en fais pas pour moi. "]},{"code":401,"indent":0,"parameters":["J'ai toujours cette chose qui m'apaise quoi qu'il arrive."]},{"code":101,"indent":0,"parameters":["",0,1,2,""]},{"code":401,"indent":0,"parameters":["Puisse tu affronter les épreuves de la vie."]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":11,"y":8}
